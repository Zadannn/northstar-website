---
import "../styles/fonts.css";
import "../styles/global.css";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Page not found · Northstar samples</title>
    <meta name="description" content="That page is not on the Northstar samples." />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <main id="main" class="not-found">
      <div class="wrap">
        <p class="eyebrow">404</p>
        <h1>That page is not here.</h1>
        <p class="lede">The link may be old, or the page was never added.</p>
        <div class="button-row">
          <a class="button" href="/">Northstar samples</a>
        </div>
      </div>
    </main>
  </body>
</html>
