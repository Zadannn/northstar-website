---
import QuoteForm from "./QuoteForm.astro";
import SampleLayout from "../layouts/SampleLayout.astro";
import type { SampleSite } from "../config/sites";

interface Props {
  site: SampleSite;
}

const { site } = Astro.props;
---

<SampleLayout site={site} title="Request a free quote" description={site.quoteDescription}>
  <header class="page-hero">
    <div class="wrap">
      <p class="eyebrow">Quote</p>
      <h1>Request a free quote</h1>
      <p class="lede">{site.quoteLede}</p>
    </div>
  </header>
  <section class="section" aria-labelledby="quote-page-heading">
    <div class="wrap">
      <h2 id="quote-page-heading" class="visually-hidden">Quote form</h2>
      <QuoteForm site={site} />
    </div>
  </section>
</SampleLayout>
