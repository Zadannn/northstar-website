---
import CallBar from "../components/CallBar.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import { paletteStyle, type SampleSite } from "../config/sites";
import "../styles/fonts.css";
import "../styles/global.css";
import "../styles/samples.css";

interface Props {
  site: SampleSite;
  title: string;
  description: string;
}

const { site, title, description } = Astro.props;
const documentTitle = `${title} · ${site.name}`;
---

<!doctype html>
<html lang="en" data-site={site.id} style={paletteStyle(site.palette)}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{documentTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#f4f1eb" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={documentTitle} />
    <meta property="og:description" content={description} />
    <meta name="twitter:card" content="summary" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="draft-banner" role="region" aria-label="Notice">
      <p>{site.banner}</p>
    </div>
    <Header site={site} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer site={site} />
    <CallBar site={site} />
  </body>
</html>
