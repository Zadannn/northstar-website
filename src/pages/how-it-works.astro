---
import Cta from "../components/Cta.astro";
import PageHero from "../components/PageHero.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { detailedSteps } from "../config/site";
---

<BaseLayout
  title="How it works"
  description="Discovery, planning, development, testing, launch, and support. The scope is written down before the work starts."
>
  <PageHero
    eyebrow="How it works"
    title="From the first conversation to a handover you can run."
    lede="Every project follows the same shape. The size of each step depends on whether we are building a website, configuring a CRM, automating a workflow, or doing more than one of those."
  />

  <section class="section" aria-labelledby="steps-heading">
    <div class="wrap">
      <h2 id="steps-heading" class="visually-hidden">Project steps</h2>
      <div class="process-grid six">
        {
          detailedSteps.map((step) => (
            <article class="card">
              <span class="process-num">{step.number}</span>
              <h3>{step.title}</h3>
              <p>{step.text}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap prose">
      <h2>What you will have at the end</h2>
      <p>
        The website, CRM setup, or workflow described in the scope. Access that belongs to you. A short note of how
        ordinary updates are made. Support only as far as that scope goes.
      </p>
      <p>There is no public price list. Requirements come first, then a proposal.</p>
    </div>
  </section>

  <Cta />
</BaseLayout>
