---
import Cta from "../components/Cta.astro";
import PageHero from "../components/PageHero.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { steps } from "../config/site";
---

<BaseLayout
  title="How it works"
  description="How a Northstar project runs: a conversation, a written plan, a build you can see, and a handoff your team can use."
>
  <PageHero
    kicker="How it works"
    title="A short path from the first call to something your team can run."
    lede="We keep the process small on purpose. You always know what is being built, what it will cost, and who is doing the work. The prices published on this draft are still placeholders."
  />

  <section class="section" aria-labelledby="steps-heading">
    <div class="wrap">
      <h2 id="steps-heading" class="visually-hidden">The four steps</h2>
      <ol class="steps">
        {
          steps.map((step) => (
            <li class="step">
              <h3>{step.title}</h3>
              <p>{step.detail}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section">
    <div class="wrap split">
      <article>
        <h2>What we need from you</h2>
        <ul class="checklist">
          <li>Someone who knows how the shop actually runs</li>
          <li>A few examples of jobs you are proud of</li>
          <li>A person who can answer questions within a few days</li>
        </ul>
      </article>
      <article>
        <h2>What you leave with</h2>
        <ul class="checklist">
          <li>The site, CRM, or automation we agreed on</li>
          <li>A walkthrough with the people who will use it</li>
          <li>Notes for the changes you will make yourselves</li>
        </ul>
      </article>
    </div>
  </section>

  <Cta />
</BaseLayout>

<style>
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
