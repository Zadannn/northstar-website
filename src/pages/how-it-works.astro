---
import Cta from "../components/Cta.astro";
import Faq from "../components/Faq.astro";
import PageHero from "../components/PageHero.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { notes, steps } from "../config/site";
---

<BaseLayout
  title="How it works"
  description="Discovery, planning, development, testing, launch, and support. Scope is agreed before development, with no guaranteed timeline."
>
  <PageHero
    kicker="How it works"
    title="From the first conversation to a careful handover."
    lede="Discovery, planning, development, testing, launch, and support. Scope and deliverables are agreed before development. We do not promise a fixed timeline."
  />

  <section class="section" aria-labelledby="steps-heading">
    <div class="wrap">
      <div class="section-head">
        <h2 id="steps-heading">The six steps</h2>
        <p>{notes.scope}</p>
      </div>
      <ol class="process-grid">
        {
          steps.map((step, index) => (
            <li>
              <p class="step-num">{String(index + 1).padStart(2, "0")}</p>
              <h3>{step.title}</h3>
              <p>{step.detail}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section" aria-labelledby="needs-heading">
    <div class="wrap split">
      <article class="panel">
        <h2 id="needs-heading">What we need from you</h2>
        <ul class="checklist">
          <li>Someone who can describe how the business runs and review the work</li>
          <li>The services you want explained, plus any logo or photos you already have the rights to use</li>
          <li>Access to the tools you want configured, in accounts you own</li>
          <li>One combined set of feedback for each review round</li>
        </ul>
      </article>
      <article class="panel">
        <h2>What you leave with</h2>
        <ul class="checklist">
          <li>The website, CRM configuration, or automation described in the scope</li>
          <li>Domains and tool accounts in your name, with the access details</li>
          <li>A short guide to the work that was handed over</li>
          <li>Any support arrangement written down, if you asked for one</li>
        </ul>
      </article>
    </div>
  </section>

  <Faq />
  <Cta />
</BaseLayout>
