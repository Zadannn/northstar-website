---
import Cta from "../components/Cta.astro";
import Faq from "../components/Faq.astro";
import PageHero from "../components/PageHero.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { steps } from "../config/site";
---

<BaseLayout
  title="How it works"
  description="How a Northstar project runs: a conversation, a written plan, a preview you can review, and a launch with a clear handover."
>
  <PageHero
    kicker="How it works"
    title="A short path from the first call to a site you can rely on."
    lede="We keep the process small on purpose. You always know what is being built, what it will cost, and who is doing the work. The prices published on this draft are still placeholders."
  />

  <section class="section" aria-labelledby="steps-heading">
    <div class="wrap">
      <h2 id="steps-heading" class="visually-hidden">The four steps</h2>
      <ol class="steps">
        {
          steps.map((step) => (
            <li class="step">
              <h3>{step.title}</h3>
              <p>{step.detail}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section">
    <div class="wrap split">
      <article>
        <h2>What we need from you</h2>
        <ul class="checklist">
          <li>Someone who knows how the business runs and can answer questions within a few days</li>
          <li>Your logo, photos of real jobs, and a short list of the services and towns you want shown</li>
          <li>One combined list of changes for each round of feedback</li>
        </ul>
      </article>
      <article>
        <h2>What you leave with</h2>
        <ul class="checklist">
          <li>The website, care plan, or follow-up setup we agreed on</li>
          <li>Ownership of your domain and accounts, with the access details</li>
          <li>A short guide for the changes you will make yourself</li>
        </ul>
      </article>
    </div>
  </section>

  <Faq />

  <Cta />
</BaseLayout>

<style>
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
