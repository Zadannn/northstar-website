---
import Cta from "../components/Cta.astro";
import Faq from "../components/Faq.astro";
import HeroVisual from "../components/HeroVisual.astro";
import ProjectList from "../components/ProjectList.astro";
import ServiceCard from "../components/ServiceCard.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { businessTypes, notes, paths, principles, problems, services, site, steps } from "../config/site";
---

<BaseLayout title="Professional websites for businesses ready to grow" description={site.description}>
  <header class="page-hero home-hero">
    <div class="wrap hero-grid">
      <div>
        <p class="eyebrow">Website development</p>
        <h1>Professional websites for businesses ready to grow.</h1>
        <p class="lede">
          We build modern, responsive websites that help small businesses establish a stronger online presence and
          make it easier for customers to get in touch.
        </p>
        <div class="button-row">
          <a class="button" href={site.cta.href}>{site.cta.label}</a>
          <a class="button button-secondary" href={site.secondaryCta.href}>{site.secondaryCta.label}</a>
        </div>
      </div>
      <HeroVisual />
    </div>
  </header>

  <section class="section" aria-labelledby="services-heading">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Services</p>
        <h2 id="services-heading">Six website services, clearly scoped.</h2>
        <p>Use one, or combine them in a single written plan. We do not sell a software product.</p>
      </div>
      <div class="card-grid">
        {services.map((service, index) => <ServiceCard service={service} index={index} />)}
      </div>
      <p class="note">
        We do not promise rankings, traffic, leads, or revenue.
        <a href={paths.webDevelopment}>Read the website scope</a>.
      </p>
    </div>
  </section>

  <section class="section band" id="selected-work" aria-labelledby="work-heading">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Selected work</p>
        <h2 id="work-heading">One website, shown as it is.</h2>
        <p>{notes.work}</p>
      </div>
      <ProjectList headingLevel="h3" />
      <div class="button-row">
        <a class="button button-secondary" href={paths.ourWork}>See our work</a>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="problems-heading">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">The problems</p>
        <h2 id="problems-heading">Familiar friction, before a new website.</h2>
        <p>Owners usually come to us with one of these, sometimes with more than one.</p>
      </div>
      <ul class="problem-grid">
        {
          problems.map((problem, index) => (
            <li>
              <p class="step-num">{String(index + 1).padStart(2, "0")}</p>
              <h3>{problem.title}</h3>
              <p>{problem.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section" aria-labelledby="types-heading">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Who it is for</p>
        <h2 id="types-heading">Many kinds of business. No single niche.</h2>
        <p>{notes.businesses}</p>
      </div>
      <ul class="type-grid">
        {
          businessTypes.map((type) => (
            <li>
              <h3>{type.title}</h3>
              <p>{type.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section" aria-labelledby="process-heading">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Process</p>
        <h2 id="process-heading">A sequence you can follow.</h2>
        <p>{notes.scope}</p>
      </div>
      <ol class="process-grid">
        {
          steps.map((step, index) => (
            <li>
              <p class="step-num">{String(index + 1).padStart(2, "0")}</p>
              <h3>{step.title}</h3>
              <p>{step.summary}</p>
            </li>
          ))
        }
      </ol>
      <div class="button-row">
        <a class="button button-secondary" href={paths.howItWorks}>Read the full process</a>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="principles-heading">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Principles</p>
        <h2 id="principles-heading">What you can expect from the work.</h2>
        <p>Short on purpose. These are working rules, not a list of awards.</p>
      </div>
      <ul class="principle-grid">
        {
          principles.map((principle) => (
            <li>
              <h3>{principle.title}</h3>
              <p>{principle.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <Faq />
  <Cta />
</BaseLayout>
