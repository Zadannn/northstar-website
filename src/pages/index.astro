---
import Cta from "../components/Cta.astro";
import Photo from "../components/Photo.astro";
import Price from "../components/Price.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { services, site, steps, trades } from "../config/site";
---

<BaseLayout
  title="Clear websites and lead follow-up for New Jersey service businesses"
  description={site.description}
>
  <header class="page-hero">
    <div class="wrap hero-grid">
      <div>
        <p class="kicker">{site.name} · Serving {site.location}</p>
        <h1>Clear, mobile-friendly websites for New Jersey home-service businesses.</h1>
        <p class="lede">
          {site.name} is a small US–India team. We build simple websites for cleaners, landscapers, plumbers, and HVAC
          companies, so customers can see what you do and call or ask for a quote. We can also set up the follow-up, so
          enquiries do not go cold.
        </p>
        <div class="button-row">
          <a class="button" href="/services">See the services</a>
          <a class="button button-secondary" href="/contact">Contact</a>
        </div>
      </div>
      <Photo {...site.photos.hero} priority />
    </div>
  </header>

  <section class="section" aria-labelledby="services-heading">
    <div class="wrap">
      <div class="section-head">
        <h2 id="services-heading">What we offer</h2>
        <p>Most clients start with a website. Prices on this draft are placeholders.</p>
      </div>
      <div class="card-grid">
        {
          services.map((service, index) => (
            <article class="card">
              <p class="index-num">{String(index + 1).padStart(2, "0")}</p>
              <h3>
                <a href={`/services/${service.slug}`}>{service.title}</a>
              </h3>
              <p>{service.summary}</p>
              <Price amount={site.prices[service.priceKey]} />
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="who-heading">
    <div class="wrap">
      <div class="section-head">
        <h2 id="who-heading">Who it is for</h2>
        <p>
          Owner-run service businesses where customers call or ask for a quote. We are starting with four trades so we
          can do them well.
        </p>
      </div>
      <ul class="pills">
        {trades.map((trade) => <li>{trade}</li>)}
      </ul>
    </div>
  </section>

  <section class="section" aria-labelledby="process-heading">
    <div class="wrap">
      <div class="section-head">
        <h2 id="process-heading">How it works</h2>
        <p>Four steps, with a written scope and price before any work starts.</p>
      </div>
      <ol class="steps">
        {
          steps.map((step) => (
            <li class="step">
              <h3>{step.title}</h3>
              <p>{step.summary}</p>
            </li>
          ))
        }
      </ol>
      <div class="button-row">
        <a class="button button-secondary" href="/how-it-works">Read the full process</a>
      </div>
    </div>
  </section>

  <Cta />
</BaseLayout>
