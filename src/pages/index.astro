---
import Cta from "../components/Cta.astro";
import Faq from "../components/Faq.astro";
import HeroVisual from "../components/HeroVisual.astro";
import ServiceCard from "../components/ServiceCard.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import {
  businessTypes,
  notes,
  positioning,
  principles,
  problems,
  serviceHref,
  services,
  site,
  steps,
  workflow,
} from "../config/site";
---

<BaseLayout title="Websites, CRM setup, and business automation" description={site.description}>
  <header class="page-hero home-hero">
    <div class="wrap hero-grid">
      <div>
        <p class="eyebrow">Websites, CRM, and automation</p>
        <h1>Better digital experiences. Smarter business operations.</h1>
        <p class="lede">
          {site.name} helps small businesses and growing companies improve a digital presence, organise customer
          information, and simplify repetitive processes. Each service stands on its own.
        </p>
        <ul class="hero-services">
          {
            services.map((service, index) => (
              <li>
                <a href={serviceHref(service.slug)}>
                  <span class="hero-index">{String(index + 1).padStart(2, "0")}</span>
                  {service.title}
                </a>
              </li>
            ))
          }
        </ul>
        <div class="button-row">
          <a class="button" href={site.cta.href}>{site.cta.label}</a>
          <a class="button button-secondary" href={site.secondaryCta.href}>{site.secondaryCta.label}</a>
        </div>
      </div>
      <HeroVisual />
    </div>
  </header>

  <section class="section" aria-labelledby="practice-heading">
    <div class="wrap split">
      <div>
        <p class="eyebrow">The practice</p>
        <h2 id="practice-heading">A clearer presence, and operations that are easier to run.</h2>
        <p class="lede">{positioning.detail}</p>
      </div>
      <div class="panel practice-panel">
        <h3>What we take on</h3>
        <ul class="checklist">
          {
            services.map((service) => (
              <li>
                <a href={serviceHref(service.slug)}>{service.title}</a>
              </li>
            ))
          }
        </ul>
        <h3>What we do not claim</h3>
        <ul class="checklist checklist-muted">
          <li>A CRM, automation platform, or AI product of our own</li>
          <li>Guaranteed rankings, revenue, or a fixed launch date</li>
          <li>Work limited to one industry or one region</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="section section-join" aria-labelledby="services-heading">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Services</p>
        <h2 id="services-heading">Three services, equal in weight.</h2>
        <p>Use one, or combine them. Nothing here is a bundle you have to buy.</p>
      </div>
      <div class="card-grid">
        {services.map((service) => <ServiceCard service={service} />)}
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="problems-heading">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">The problems</p>
        <h2 id="problems-heading">Familiar friction, before any new tool.</h2>
        <p>Owners usually come to us with one of these, sometimes with all four.</p>
      </div>
      <ul class="problem-grid">
        {
          problems.map((problem, index) => (
            <li>
              <p class="step-num">{String(index + 1).padStart(2, "0")}</p>
              <h3>{problem.title}</h3>
              <p>{problem.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section band" aria-labelledby="workflow-heading">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Connected work</p>
        <h2 id="workflow-heading">One way the services can meet.</h2>
        <p>{notes.workflow}</p>
      </div>
      <ol class="workflow">
        {
          workflow.map((step, index) => (
            <li>
              <span class="flow-index">{index + 1}</span>
              <h3>{step.title}</h3>
              <p>{step.summary}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section" aria-labelledby="types-heading">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Who it is for</p>
        <h2 id="types-heading">Many kinds of business. No single niche.</h2>
        <p>{notes.businesses}</p>
      </div>
      <ul class="type-grid">
        {
          businessTypes.map((type) => (
            <li>
              <h3>{type.title}</h3>
              <p>{type.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section" aria-labelledby="process-heading">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Process</p>
        <h2 id="process-heading">A sequence you can follow.</h2>
        <p>{notes.scope}</p>
      </div>
      <ol class="process-grid">
        {
          steps.map((step, index) => (
            <li>
              <p class="step-num">{String(index + 1).padStart(2, "0")}</p>
              <h3>{step.title}</h3>
              <p>{step.summary}</p>
            </li>
          ))
        }
      </ol>
      <div class="button-row">
        <a class="button button-secondary" href="/how-it-works">Read the full process</a>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="principles-heading">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Principles</p>
        <h2 id="principles-heading">What you can expect from the work.</h2>
        <p>Short on purpose. These are working rules, not a list of awards.</p>
      </div>
      <ul class="principle-grid">
        {
          principles.map((principle) => (
            <li>
              <h3>{principle.title}</h3>
              <p>{principle.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <Faq />
  <Cta />
</BaseLayout>
