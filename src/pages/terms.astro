---
import PageHero from "../components/PageHero.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { formAction, legalNav, notes, site } from "../config/site";

const formLive = formAction() !== null;
---

<BaseLayout
  title="Terms"
  description={`Placeholder terms for the ${site.name} draft website. They are not a contract and have not been legally reviewed.`}
>
  <PageHero
    kicker="Terms"
    title="What this draft is, and what it is not."
    lede={notes.legal}
  />

  <section class="section" aria-labelledby="terms-heading">
    <div class="wrap prose">
      <div class="notice">
        <p>
          <strong>Placeholder.</strong> These terms have not been reviewed by a lawyer. They are not a client
          agreement, and they do not guarantee that the site or the services comply with any law.
        </p>
      </div>

      <h2 id="terms-heading">Using this website</h2>
      <p>
        {site.name} is a placeholder name on a draft website. Pages can change. The phone number and email address are
        stand-ins. Nothing on the site is an offer you can accept through a form.
        {
          formLive
            ? " The contact form only sends what you submit to the configured form address. Sending it does not start a project."
            : " The enquiry form is not available on this draft."
        }
      </p>

      <h2>Services are agreed separately</h2>
      <p>
        Website development is described so you can see the shape of the work.
        A project exists only when a written scope and price are agreed. That document, not this page, says what will
        be delivered. We do not guarantee timelines, search rankings, revenue, or a number of leads.
      </p>
      <p>Prices are not published on this draft. A figure is real only when it is in the written plan.</p>

      <h2>Accounts and tools</h2>
      <p>
        Domains and hosting stay in the client’s name when a project goes ahead. We
        do not provide those products ourselves. Their fees and their terms belong to the companies that do.
      </p>

      <h2>Before this page can be relied on</h2>
      <ul class="checklist">
        <li>Have a qualified person review it for the places you actually operate</li>
        <li>Replace the placeholder name and contact details</li>
        <li>Match it to the contract you really use with clients</li>
      </ul>
      <p>
        <a href={legalNav[0].href}>Read the placeholder privacy note</a>.
      </p>
    </div>
  </section>
</BaseLayout>
