---
import ContactDetails from "../components/ContactDetails.astro";
import PageHero from "../components/PageHero.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { notes, services, site } from "../config/site";

const formLive = Boolean(site.formEndpoint);
---

<BaseLayout
  title="Contact"
  description={`Talk to ${site.name} about a website, CRM setup, or a practical automation. The form stays off until a real form address is configured.`}
>
  <PageHero
    kicker="Contact"
    title="Tell us what you want to improve."
    lede={formLive
      ? "Send a message, or email or call. Tell us what the business does and whether you are asking about a website, a CRM, automation, or more than one."
      : "The form on this page is switched off. It does not send anything, and there is no success message behind it. Email or call, and tell us what the business does and what you want help with."}
  />

  <section class="section" aria-labelledby="contact-heading">
    <div class="wrap contact-grid">
      <div>
        <h2 id="contact-heading">Phone and email</h2>
        <ContactDetails large />
        <p class="note">
          These contact details are placeholders until the real ones are ready. We are not limited to one city or one
          industry.
        </p>
      </div>

      <form
        class="contact-form"
        method={formLive ? "post" : undefined}
        action={formLive ? site.formEndpoint : undefined}
        aria-describedby="form-status"
      >
        <div id="form-status" class="form-status">
          <p>{formLive ? "We use what you send only to reply. Please do not include passwords or payment details." : notes.formOff}</p>
        </div>
        <fieldset disabled={!formLive}>
          <legend>Send a message</legend>
          <div class="fields">
            <div class="fields-split">
              <div>
                <label for="name">Your name <span class="req">(required)</span></label>
                <input id="name" name="name" type="text" autocomplete="name" required />
              </div>
              <div>
                <label for="email">Email <span class="req">(required)</span></label>
                <input id="email" name="email" type="email" autocomplete="email" required />
              </div>
            </div>
            <div class="fields-split">
              <div>
                <label for="phone">Phone</label>
                <input id="phone" name="phone" type="tel" autocomplete="tel" inputmode="tel" />
              </div>
              <div>
                <label for="business">Business name</label>
                <input id="business" name="business" type="text" autocomplete="organization" />
              </div>
            </div>
            <div class="fields-split">
              <div>
                <label for="website">Current website</label>
                <input id="website" name="website" type="url" inputmode="url" autocomplete="url" />
              </div>
              <div>
                <label for="need">What do you need? <span class="req">(required)</span></label>
                <select id="need" name="need" required>
                  <option value="">Select one</option>
                  {services.map((service) => <option>{service.title}</option>)}
                  <option>Not sure yet</option>
                </select>
              </div>
            </div>
            <div>
              <label for="message">Message <span class="req">(required)</span></label>
              <textarea id="message" name="message" required></textarea>
            </div>
            <div class="hp" aria-hidden="true">
              <label for="company-website">Leave this empty</label>
              <input id="company-website" name="_gotcha" type="text" tabindex="-1" autocomplete="off" />
            </div>
            <button class="button" type="submit" disabled={!formLive}>
              {formLive ? "Send message" : "Form unavailable"}
            </button>
          </div>
        </fieldset>
      </form>
    </div>
  </section>
</BaseLayout>
