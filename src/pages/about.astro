---
import Cta from "../components/Cta.astro";
import PageHero from "../components/PageHero.astro";
import Photo from "../components/Photo.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { founders, notes, paths, positioning, serviceHref, services, site } from "../config/site";

const showPhoto = !site.placeholders.photos;
const [coordination, delivery] = founders;
---

<BaseLayout title="About" description={positioning.summary}>
  <PageHero kicker="About" title="A small team, and a practical way of working." lede={positioning.detail} />

  <section class="section" aria-labelledby="team-heading">
    <div class:list={["wrap", showPhoto && "split"]}>
      <div class="prose">
        <h2 id="team-heading">Who you will talk to</h2>
        <p>
          Your main contact is on the US side. They lead the conversation, collect what we need from you, and bring
          your feedback back. The technical work is done remotely by our technical lead in India. Scope and price are
          agreed between us before anything is promised to you.
        </p>
        <p>
          We are a small team, not a large firm with a separate sales desk. You deal with the people doing the work. If
          a request sits outside website development, CRM configuration, or practical automation, we will say so.
        </p>
        <p>
          We keep the work in a few hands on purpose. The people you talk to are the same people who plan and build
          what you asked for, so nothing gets lost in a handoff.
        </p>
        <p>{notes.scope}</p>

        <section aria-labelledby="founders-heading">
          <h2 id="founders-heading">Two founders, two roles</h2>
          <p>
            {`${site.name} is run by its two founders. ${coordination.name} handles ${coordination.role}: ${coordination.responsibilities}. ${delivery.name} handles ${delivery.role}: ${delivery.responsibilities}.`}
          </p>
          <p>
            The two roles fit together. One of us stays close to your day-to-day needs while the other stays close to
            the build, so you get clear answers without a chain of account managers in between.
          </p>
        </section>

        <h2>The work itself</h2>
        <ul class="checklist">
          {
            services.map((service) => (
              <li>
                <a href={serviceHref(service.slug)}>{service.title}</a>
              </li>
            ))
          }
        </ul>
        <p class="note">
          <a href={paths.howItWorks}>See how a project runs</a>. Until launch, treat the phone number and email address as
          stand-ins.
        </p>
      </div>
      {showPhoto && <Photo {...site.photos.about} />}
    </div>
  </section>

  <Cta />
</BaseLayout>
