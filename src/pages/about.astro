---
import Cta from "../components/Cta.astro";
import PageHero from "../components/PageHero.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { principles, site } from "../config/site";
---

<BaseLayout
  title="About"
  description={`How ${site.name} approaches website development, CRM setup, and business automation.`}
>
  <PageHero
    eyebrow="About"
    title="Practical digital work, scoped before it is built."
    lede={`${site.name} helps businesses with websites, CRM setup, and automation. The aim is simple: the public site, the customer record, and the everyday follow-up should make the work easier, not add another system to babysit.`}
  />

  <section class="section">
    <div class="wrap prose">
      <h2>How we approach a project</h2>
      <p>
        We start by asking what is awkward today. That might be a site people cannot understand, a pile of enquiries
        with no shared list, or a task someone repeats after every form. We then propose the smallest setup that
        addresses that problem, and we write down what is included.
      </p>
      <p>
        We configure tools and build the pages we agreed. We do not treat a custom-built CRM, an AI product, or a
        complex integration as the default. If the request needs that, we say so and it becomes its own scope.
      </p>
      <p>
        This page does not include a company history, team biographies, or a list of past clients. Those are not
        invented here. What you can judge is the way the work is described and the limits we put on it.
      </p>
    </div>
  </section>

  <section class="section" aria-labelledby="principles-heading">
    <div class="wrap">
      <h2 id="principles-heading">Principles</h2>
      <div class="principle-grid">
        {
          principles.map((item) => (
            <article>
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <Cta />
</BaseLayout>
