---
import Cta from "../components/Cta.astro";
import PageHero from "../components/PageHero.astro";
import Photo from "../components/Photo.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { notes, positioning, serviceHref, services, site } from "../config/site";

const showPhoto = !site.placeholders.photos;
---

<BaseLayout title="About" description={positioning.summary}>
  <PageHero kicker="About" title="A small team, and a practical way of working." lede={positioning.detail} />

  <section class="section" aria-labelledby="team-heading">
    <div class:list={["wrap", showPhoto && "split"]}>
      <div class="prose">
        <h2 id="team-heading">Who you will talk to</h2>
        <p>
          Your main contact is on the US side. They lead the conversation, collect what we need from you, and bring
          your feedback back. The technical work is done remotely by our technical lead in India. Scope and price are
          agreed between us before anything is promised to you.
        </p>
        <p>
          We are a small team, not a large firm with a separate sales desk. You deal with the people doing the work. If
          a request sits outside website development, CRM configuration, or practical automation, we will say so.
        </p>
        <h2>What we will not invent</h2>
        <p>
          There are no customer logos, testimonials, or case studies on this site, because we will not publish proof we
          cannot stand behind. {notes.scope}
        </p>
        <h2>The work itself</h2>
        <ul class="checklist">
          {
            services.map((service) => (
              <li>
                <a href={serviceHref(service.slug)}>{service.title}</a>
              </li>
            ))
          }
        </ul>
        <p class="note">
          <a href="/how-it-works">See how a project runs</a>. Until launch, treat the phone number and email address as
          stand-ins.
        </p>
      </div>
      {showPhoto && <Photo {...site.photos.about} />}
    </div>
  </section>

  <Cta />
</BaseLayout>
