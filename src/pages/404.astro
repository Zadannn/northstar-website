---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Page not found" description="That page is not on the Northstar site.">
  <section class="not-found">
    <div class="wrap">
      <p class="kicker">404</p>
      <h1>That page is not here.</h1>
      <p class="lede">The link may be old, or the page was never added. Try the home page, the services, or contact.</p>
      <div class="button-row">
        <a class="button" href="/">Back to home</a>
        <a class="button button-secondary" href="/services">See services</a>
        <a class="button button-secondary" href="/contact">Contact</a>
      </div>
    </div>
  </section>
</BaseLayout>
