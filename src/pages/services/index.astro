---
import Cta from "../../components/Cta.astro";
import PageHero from "../../components/PageHero.astro";
import ServiceCard from "../../components/ServiceCard.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { notes, paths, services } from "../../config/site";
---

<BaseLayout
  title="Services"
  description="Business websites, landing pages, redesigns, responsive optimisation, basic technical SEO, and deployment with a documented handover."
>
  <PageHero
    kicker="Services"
    title="Website services, with the limits written down."
    lede="Six services for a business website. Start with one, or combine them when the work calls for it. Custom software is not part of this list."
  />

  <section class="section" aria-label="Website services">
    <div class="wrap">
      <div class="card-grid">
        {services.map((service, index) => <ServiceCard service={service} index={index} level="h2" />)}
      </div>
      <p class="note">{notes.maintenance}</p>
      <div class="button-row">
        <a class="button button-secondary" href={paths.webDevelopment}>Read the website scope</a>
        <a class="button button-secondary" href={paths.howItWorks}>See how a project runs</a>
      </div>
    </div>
  </section>

  <Cta
    heading="Not sure which service fits?"
    text="Describe the business and what the website needs to do. We will tell you if we can help, and we will say so if we cannot."
  />
</BaseLayout>
