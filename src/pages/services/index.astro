---
import Cta from "../../components/Cta.astro";
import Photo from "../../components/Photo.astro";
import Price from "../../components/Price.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { services, site } from "../../config/site";
---

<BaseLayout
  title="Services"
  description="Website launch, website care, and lead follow-up setup for New Jersey home-service businesses."
>
  <header class="page-hero">
    <div class="wrap hero-grid">
      <div>
        <p class="kicker">Services</p>
        <h1>A website, its upkeep, and the follow-up that keeps enquiries from going cold.</h1>
        <p class="lede">
          Start with a website that gets calls and quote requests. Add care so it keeps working, and follow-up so a
          missed call or a quiet quote does not cost you a job. Prices below are placeholders.
        </p>
      </div>
      <Photo {...site.photos.work} />
    </div>
  </header>

  <section class="section" aria-label="Service list">
    <div class="wrap">
      <div class="card-grid">
        {
          services.map((service) => (
            <article class="card" id={service.slug}>
              <h2>
                <a href={`/services/${service.slug}`}>{service.title}</a>
              </h2>
              <p>{service.summary}</p>
              <Price amount={site.prices[service.priceKey]} />
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <Cta heading="Not sure where to start?" text="Describe your business and what keeps slipping. We will tell you honestly where to start, even if that is only a website." />
</BaseLayout>
