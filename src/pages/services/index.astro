---
import Cta from "../../components/Cta.astro";
import PageHero from "../../components/PageHero.astro";
import ServiceCard from "../../components/ServiceCard.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { notes, services } from "../../config/site";
---

<BaseLayout
  title="Services"
  description="Website development, CRM setup, and practical business automation. Each service stands on its own."
>
  <PageHero
    kicker="Services"
    title="Three services, with the same care in each."
    lede="Website development, CRM solutions, and business automation. They are equal parts of the practice. Start with one, or combine them when the work calls for it."
  />

  <section class="section" aria-label="Service comparison">
    <div class="wrap">
      <div class="card-grid">
        {services.map((service) => <ServiceCard service={service} level="h2" detailed />)}
      </div>
      <p class="note">{notes.workflow}</p>
      <div class="button-row">
        <a class="button button-secondary" href="/how-it-works">See how a project runs</a>
      </div>
    </div>
  </section>

  <Cta
    heading="Not sure which service fits?"
    text="Describe the business and what is getting in the way. We will tell you if we can help, and we will say so if we cannot."
  />
</BaseLayout>
