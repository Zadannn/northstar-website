---
import Wordmark from "./Wordmark.astro";
import { nav, site } from "../config/site";

function normalize(pathname: string): string {
  const path = pathname.split("#")[0].split("?")[0];
  if (path === "/") return "/";
  return path.replace(/\/$/, "");
}

const path = normalize(Astro.url.pathname);

function isCurrent(href: string): boolean {
  const target = normalize(href);
  if (target === "/") return path === "/";
  return path === target || path.startsWith(`${target}/`);
}
---

<header class="site-header">
  <div class="wrap header-shell">
    <a class="logo" href="/" aria-label={`${site.name}, home`}>
      <Wordmark decorative />
    </a>
    <nav class="desktop-nav" aria-label="Primary">
      <ul class="nav-list">
        {
          nav.map((item) => (
            <li>
              <a href={item.href} aria-current={isCurrent(item.href) ? "page" : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <a class="button header-cta" href={site.cta.href}>{site.cta.label}</a>
    <details class="menu">
      <summary class="nav-toggle">
        <span class="nav-toggle-open">Menu</span>
        <span class="nav-toggle-close">Close</span>
      </summary>
      <div class="menu-panel">
        <nav class="site-nav" aria-label="Primary">
          <ul class="nav-list">
            {
              nav.map((item) => (
                <li>
                  <a href={item.href} aria-current={isCurrent(item.href) ? "page" : undefined}>
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
        <div class="nav-cta">
          <a class="button" href={site.cta.href}>{site.cta.label}</a>
        </div>
      </div>
    </details>
  </div>
</header>

<script>
  const menu = document.querySelector(".site-header .menu");
  if (menu instanceof HTMLDetailsElement) {
    const summary = menu.querySelector("summary");
    menu.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && menu.open) {
        menu.open = false;
        if (summary instanceof HTMLElement) summary.focus();
      }
    });
  }
</script>
