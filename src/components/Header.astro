---
import Wordmark from "./Wordmark.astro";
import { nav, site } from "../config/site";

const path = Astro.url.pathname.replace(/\/$/, "") || "/";

function isCurrent(href: string): boolean {
  if (href === "/") return path === "/";
  return path === href || path.startsWith(`${href}/`);
}
---

<header class="site-header">
  <div class="wrap header-shell">
    <a class="logo" href="/" aria-label={`${site.name}, home`}>
      <Wordmark decorative />
    </a>
    <nav class="desktop-nav" aria-label="Primary">
      <ul class="nav-list">
        {
          nav.map((item) => (
            <li>
              <a href={item.href} aria-current={isCurrent(item.href) ? "page" : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <a class="button header-cta" href={site.cta.href}>{site.cta.label}</a>
    <details class="menu">
      <summary class="nav-toggle">
        <span class="nav-toggle-open">Menu</span>
        <span class="nav-toggle-close">Close</span>
      </summary>
      <div class="menu-panel">
        <nav class="site-nav" aria-label="Primary">
          <ul class="nav-list">
            {
              nav.map((item) => (
                <li>
                  <a href={item.href} aria-current={isCurrent(item.href) ? "page" : undefined}>
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
        <div class="nav-cta">
          <a class="button" href={site.cta.href}>{site.cta.label}</a>
        </div>
      </div>
    </details>
  </div>
</header>
