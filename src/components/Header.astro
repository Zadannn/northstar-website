---
import Wordmark from "./Wordmark.astro";
import { nav, site } from "../config/site";

const path = Astro.url.pathname.replace(/\/$/, "") || "/";

function isCurrent(href: string): boolean {
  if (href === "/") return path === "/";
  if (href === "/services") {
    return path === "/services" || path === "/web-development" || path === "/crm-automation";
  }
  return path === href || path.startsWith(`${href}/`);
}
---

<header class="site-header">
  <div class="wrap header-bar">
    <Wordmark href="/" />
    <details class="menu">
      <summary class="nav-toggle">
        <span class="nav-toggle-open">Menu</span>
        <span class="nav-toggle-close">Close</span>
      </summary>
      <nav class="site-nav" aria-label="Primary">
        <ul class="nav-list">
          {
            nav.map((item) => (
              <li>
                <a href={item.href} aria-current={isCurrent(item.href) ? "page" : undefined}>
                  {item.label}
                </a>
              </li>
            ))
          }
          <li class="nav-cta">
            <a class="button" href={site.cta.href}>{site.cta.label}</a>
          </li>
        </ul>
      </nav>
    </details>
  </div>
</header>
