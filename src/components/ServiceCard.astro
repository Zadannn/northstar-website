---
import { serviceHref, type Service } from "../config/site";

interface Props {
  service: Service;
  index: number;
  level?: "h2" | "h3";
}

const { service, index, level = "h3" } = Astro.props;
const Heading = level;
---

<article class="card service-card">
  <p class="index-label">{String(index + 1).padStart(2, "0")}</p>
  <Heading>
    <a href={serviceHref(service.id)}>{service.title}</a>
  </Heading>
  <p>{service.summary}</p>
</article>
