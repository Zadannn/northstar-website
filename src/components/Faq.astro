---
import { faqs } from "../config/site";

interface Props {
  heading?: string;
  lede?: string;
}

const { heading = "Questions we answer directly", lede = "Plain answers, including the limits of what we will promise." } =
  Astro.props;
---

<section class="section" aria-labelledby="faq-heading">
  <div class="wrap">
    <div class="section-head">
      <h2 id="faq-heading">{heading}</h2>
      <p>{lede}</p>
    </div>
    <div class="faq">
      {
        faqs.map((item) => (
          <details>
            <summary>
              <h3>{item.question}</h3>
            </summary>
            <p>{item.answer}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>
