---
import ContactDetails from "./ContactDetails.astro";
import Wordmark from "./Wordmark.astro";
import { legalNav, nav, services, serviceHref, site } from "../config/site";

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap footer-grid">
    <div class="footer-brand">
      <a class="logo" href="/" aria-label={`${site.name}, home`}>
        <Wordmark decorative />
      </a>
      <p>{site.tagline}</p>
    </div>
    <nav aria-label="Services">
      <p class="footer-heading">Services</p>
      <ul class="footer-nav">
        {
          services.map((service) => (
            <li>
              <a href={serviceHref(service.slug)}>{service.title}</a>
            </li>
          ))
        }
      </ul>
    </nav>
    <nav aria-label="Pages">
      <p class="footer-heading">Explore</p>
      <ul class="footer-nav">
        {
          nav.map((item) => (
            <li>
              <a href={item.href}>{item.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>
    <div>
      <p class="footer-heading">Contact</p>
      <ContactDetails />
    </div>
  </div>
  <div class="wrap legal-row">
    <p>
      © {year} {site.name}.
      {site.draft && " Draft website. Not published."}
    </p>
    {
      legalNav.map((item) => (
        <a href={item.href}>{item.label}</a>
      ))
    }
  </div>
</footer>
