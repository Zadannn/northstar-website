---
import Mark from "./Mark.astro";
import { nav, site } from "../config/site";

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap footer-grid">
    <div>
      <p class="logo-lockup">
        <Mark size={26} />
        <span>{site.name}</span>
      </p>
      <p>
        Websites and lead follow-up for local-service businesses in {site.location}.
      </p>
    </div>
    <address>
      <p class="contact-line">
        {site.placeholders.contact && <span class="placeholder-tag">Placeholder</span>}
        <a href={site.phoneHref}>{site.phoneDisplay}</a>
      </p>
      <p class="contact-line">
        {site.placeholders.contact && <span class="placeholder-tag">Placeholder</span>}
        <a href={`mailto:${site.email}`}>{site.email}</a>
      </p>
    </address>
    <nav aria-label="Footer">
      <ul class="footer-nav">
        {
          nav.map((item) => (
            <li>
              <a href={item.href}>{item.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
  <div class="wrap">
    <p class="legal">
      © {year} {site.name}.
      {site.draft && " Draft website — not published yet."}
    </p>
  </div>
</footer>
