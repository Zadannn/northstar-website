---
import Wordmark from "./Wordmark.astro";
import { legalPaths, nav, services, site } from "../config/site";

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap footer-grid">
    <div>
      <Wordmark />
      <p>Websites, CRM setup, and practical automation for businesses that want clearer customer experiences and simpler day-to-day work.</p>
    </div>
    <nav aria-label="Footer">
      <h2>Explore</h2>
      <ul class="footer-links">
        {
          nav.map((item) => (
            <li>
              <a href={item.href}>{item.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>
    <nav aria-label="Services">
      <h2>Services</h2>
      <ul class="footer-links">
        {
          services.map((service) => (
            <li>
              <a href={service.href}>{service.title}</a>
            </li>
          ))
        }
      </ul>
    </nav>
    <address>
      <h2>Contact</h2>
      <p class="contact-line">
        {site.placeholders.contact && <span class="placeholder-tag">Placeholder</span>}
        <a href={site.phoneHref}>{site.phoneDisplay}</a>
      </p>
      <p class="contact-line">
        {site.placeholders.contact && <span class="placeholder-tag">Placeholder</span>}
        <a href={`mailto:${site.email}`}>{site.email}</a>
      </p>
    </address>
  </div>
  <div class="wrap legal-row">
    {
      legalPaths.map((item) => (
        <a href={item.href}>{item.label}</a>
      ))
    }
    <span>© {year} {site.name}.{site.draft && " Draft website — not published yet."}</span>
  </div>
</footer>
