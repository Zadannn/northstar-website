---
import { site } from "../config/site";

interface Props {
  heading?: string;
  text?: string;
}

const {
  heading = "Have an idea? Let's make it work.",
  text = "Tell us what you're trying to improve. We'll help you explore a practical digital solution for your business.",
} = Astro.props;
---

<section class="cta-band" aria-labelledby="cta-heading">
  <div class="wrap">
    <h2 id="cta-heading">{heading}</h2>
    <p class="lede">{text}</p>
    <div class="button-row">
      <a class="button" href={site.cta.href}>{site.cta.label}</a>
    </div>
  </div>
</section>
