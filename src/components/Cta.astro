---
import { closing, site } from "../config/site";

interface Props {
  heading?: string;
  text?: string;
}

const { heading = closing.heading, text = closing.text } = Astro.props;
---

<section class="section" aria-labelledby="cta-heading">
  <div class="wrap">
    <div class="cta-panel">
      <p class="eyebrow">{closing.eyebrow}</p>
      <h2 id="cta-heading">{heading}</h2>
      <p>{text}</p>
      <div class="cta-actions">
        <a class="button button-inverse" href={site.cta.href}>{site.cta.label}</a>
        <p class="cta-alt">
          {site.placeholders.contact && <span class="placeholder-tag">Placeholder</span>}
          <a href={`mailto:${site.email}`}>{site.email}</a>
        </p>
      </div>
    </div>
  </div>
</section>
