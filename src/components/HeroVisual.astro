---
import { preview } from "../config/site";

const sample = preview.website;
---

<figure class="hv">
  <div class="hv-stage">
    <article class="hv-browser" aria-hidden="true">
      <div class="hv-chrome">
        <span class="hv-dot"></span>
        <span class="hv-dot"></span>
        <span class="hv-dot"></span>
        <span class="hv-url">{sample.url}</span>
      </div>
      <div class="hv-site">
        <div class="hv-top">
          <p class="hv-name">{sample.name}</p>
          <p class="hv-navline">
            {sample.nav.map((item) => <span>{item}</span>)}
          </p>
        </div>
        <p class="hv-kicker">{sample.kicker}</p>
        <p class="hv-headline">{sample.headline}</p>
        <p class="hv-text">{sample.text}</p>
        <p class="hv-items">
          {sample.items.map((item) => <span>{item}</span>)}
        </p>
        <span class="hv-action">{sample.action}</span>
      </div>
    </article>
    <article class="hv-phone" aria-hidden="true">
      <div class="hv-speaker"></div>
      <div class="hv-site hv-site-phone">
        <p class="hv-kicker">{sample.kicker}</p>
        <p class="hv-name">{sample.name}</p>
        <p class="hv-headline">{sample.headline}</p>
        <span class="hv-action">{sample.action}</span>
      </div>
    </article>
  </div>
  <figcaption>{preview.disclaimer}</figcaption>
</figure>

<style>
  .hv {
    min-width: 0;
    max-width: 100%;
    margin: 0;
  }

  .hv-stage {
    display: grid;
    gap: 0.85rem;
    min-width: 0;
  }

  .hv-browser,
  .hv-phone {
    min-width: 0;
    background: var(--color-bg-raised);
    border: 1px solid var(--color-line);
    box-shadow: var(--shadow-sm);
  }

  .hv-browser {
    border-radius: var(--radius-lg);
    overflow: hidden;
  }

  .hv-chrome {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.55rem 0.7rem;
    border-bottom: 1px solid var(--color-line);
    background: var(--color-bg-muted);
  }

  .hv-dot {
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    background: var(--color-line-strong);
    flex: none;
  }

  .hv-url {
    min-width: 0;
    margin-left: 0.35rem;
    padding: 0.12rem 0.55rem;
    overflow: hidden;
    color: var(--color-ink-soft);
    font-size: 0.75rem;
    text-overflow: ellipsis;
    white-space: nowrap;
    background: var(--color-bg-raised);
    border-radius: 999px;
  }

  .hv-site {
    padding: 0.95rem 1rem 1.1rem;
  }

  .hv-top {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.35rem 0.75rem;
    margin-bottom: 1.1rem;
  }

  .hv-kicker {
    margin: 0;
    color: var(--color-accent);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .hv-name {
    margin: 0;
    font-family: var(--font-display);
    font-size: 0.95rem;
    font-weight: 700;
    letter-spacing: -0.03em;
  }

  .hv-navline {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 0.7rem;
    margin: 0;
    color: var(--color-ink-soft);
    font-size: 0.75rem;
  }

  .hv-headline {
    margin: 0.45rem 0 0;
    max-width: 16rem;
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 2.2vw, 1.7rem);
    font-weight: 680;
    letter-spacing: -0.03em;
    line-height: 1.12;
  }

  .hv-text {
    margin: 0.7rem 0 0;
    max-width: 22rem;
    color: var(--color-ink-soft);
    font-size: 0.92rem;
    line-height: 1.45;
  }

  .hv-items {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 0.9rem 0;
  }

  .hv-items span {
    padding: 0.22rem 0.5rem;
    color: var(--color-ink-soft);
    font-size: 0.75rem;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-sm);
  }

  .hv-action {
    display: inline-flex;
    max-width: 100%;
    padding: 0.42rem 0.7rem;
    color: var(--color-bg-raised);
    font-size: 0.78rem;
    font-weight: 650;
    background: var(--color-ink);
    border-radius: var(--radius-sm);
  }

  .hv-phone {
    width: min(100%, 11.25rem);
    margin-inline: auto;
    padding: 0.45rem 0.45rem 0.7rem;
    border-radius: 1.35rem;
  }

  .hv-speaker {
    width: 2.2rem;
    height: 0.28rem;
    margin: 0.2rem auto 0.55rem;
    border-radius: 999px;
    background: var(--color-line-strong);
  }

  .hv-site-phone {
    padding: 0.35rem 0.45rem 0.55rem;
  }

  .hv-site-phone .hv-name {
    margin-top: 0.35rem;
    font-size: 0.82rem;
    line-height: 1.25;
  }

  .hv-site-phone .hv-headline {
    font-size: 1rem;
    max-width: none;
  }

  .hv-site-phone .hv-action {
    margin-top: 0.85rem;
  }

  .hv figcaption {
    margin: 0.75rem 0 0;
    color: var(--color-ink-soft);
    font-size: 0.82rem;
  }

  @media (min-width: 720px) {
    .hv-stage {
      grid-template-columns: minmax(0, 1fr) 10.5rem;
      align-items: end;
    }

    .hv-phone {
      width: auto;
      margin: 0;
    }
  }
</style>
