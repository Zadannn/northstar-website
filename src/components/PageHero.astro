---
interface Props {
  kicker?: string;
  title: string;
  lede: string;
}

const { kicker, title, lede } = Astro.props;
---

<header class="page-hero">
  <div class="wrap">
    {kicker && <p class="eyebrow">{kicker}</p>}
    <h1>{title}</h1>
    <p class="lede">{lede}</p>
    <slot />
  </div>
</header>
