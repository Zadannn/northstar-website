---
interface Props {
  src: string;
  alt: string;
  caption: string;
  priority?: boolean;
}

const { src, alt, caption, priority = false } = Astro.props;
---

<figure class="photo">
  <img
    src={src}
    alt={alt}
    width="800"
    height="600"
    decoding="async"
    fetchpriority={priority ? "high" : undefined}
  />
  <figcaption>
    <span class="placeholder-tag">Placeholder</span>
    <span>{caption}</span>
  </figcaption>
</figure>
